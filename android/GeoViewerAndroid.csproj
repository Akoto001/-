<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RootNamespace>GeoViewer</RootNamespace>
    <AssemblyName>GeometryViewer</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <ApplicationId>com.georef.geometryviewer</ApplicationId>
    <ApplicationVersion>13</ApplicationVersion>
    <ApplicationDisplayVersion>2.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProbeMode)'=='viewport'">
    <DefineConstants>$(DefineConstants);PROBE_VIEWPORT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
  </PropertyGroup>

  <!-- Reuse the portable core and software renderer of the desktop build, unchanged. -->
  <ItemGroup>
    <Compile Include="..\GeometryViewer-Project\src\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\GeometryViewer-Project\src\Render\*.cs" Link="Render\%(Filename)%(Extension)" />
    <Compile Include="MainActivity.cs" />
    <Compile Include="MotionView.cs" />
    <!-- ViewportView.cs is intentionally NOT compiled: the custom View subclass is a crash suspect
         on Android 16, the picture is drawn into an ImageView bitmap instead. -->
    <None Include="ViewportView.cs" />
  </ItemGroup>

</Project>
